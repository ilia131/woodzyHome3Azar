DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
AKSORIA_RUNTIME_PASSWORD=
AKSORIA_MIGRATION_PASSWORD=
POSTGRES_DB=aksoria
POSTGRES_USER=aksoria
# Direct Django execution; Compose sets its internal hosts and service credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
TEST_SQLITE=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=
# Local defaults. Configure HTTPS and trusted forwarding for production.
SECURE_COOKIES=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
TRUST_PROXY_HTTPS=0
# Compose configures one trusted proxy; for direct execution set the real count.
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=INFO
DJANGO_DEBUG=0
PUBLIC_PORT=8000
STORE_CURRENCY=IRR
INVENTORY_RESERVATION_SECONDS=900
PAYMENT_MODE=production
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_SIGNING_KEY=
PAYMENT_PENDING_EXPIRATION_SECONDS=900
PAYMENT_DEFAULT_PROVIDER=mock
PAYMENT_INITIATION_TIMEOUT=15
PAYMENT_VERIFICATION_TIMEOUT=15

# Future provider placeholders. Protocols and required fields are unconfirmed.
SNAPP_PAY_ENABLED=false
SNAPP_PAY_API_BASE_URL=
SNAPP_PAY_MERCHANT_ID=
SNAPP_PAY_CLIENT_ID=
SNAPP_PAY_CLIENT_SECRET=

DIGIPAY_ENABLED=false
DIGIPAY_API_BASE_URL=
DIGIPAY_MERCHANT_ID=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=

TOROB_PAY_ENABLED=false
TOROB_PAY_API_BASE_URL=
TOROB_PAY_MERCHANT_ID=
TOROB_PAY_CLIENT_ID=
TOROB_PAY_CLIENT_SECRET=

# Optional SMTP for verified recovery email and newsletter confirmation.
TRANSACTIONAL_EMAIL_ENABLED=0
STORE_EMAIL_HOST=localhost
STORE_EMAIL_PORT=587
STORE_EMAIL_USER=
STORE_EMAIL_PASSWORD=
STORE_EMAIL_TLS=1
STORE_FROM_EMAIL=webmaster@localhost

# Public HTTPS media base used in SEO metadata, e.g. https://cdn.example.com/media.
SEO_MEDIA_URL=
